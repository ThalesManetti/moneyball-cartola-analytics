# ============================================
# FOOTBALL ANALYTICS PROJECT - .gitignore
# ============================================
# Projeto Híbrido: Cartola FC + StatsBomb
# Atualizado: 03/02/2026

# ============================================
# PYTHON
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/

# ============================================
# JUPYTER NOTEBOOKS
# ============================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# ============================================
# DATA FILES (NÃO VERSIONAR DADOS GRANDES)
# ============================================
# Bronze layer (dados brutos)
data/bronze/**/*.parquet
data/bronze/**/*.csv
data/bronze/**/*.json
data/bronze/cartola/**/*
data/bronze/statsbomb/**/*

# Silver layer (dados limpos)
data/silver/**/*.parquet
data/silver/**/*.csv

# Gold layer (dados agregados)
data/gold/**/*.parquet
data/gold/**/*.csv

# EXCEÇÃO: Manter estrutura de pastas
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/bronze/cartola/.gitkeep
!data/bronze/statsbomb/.gitkeep
!data/silver/cartola/.gitkeep
!data/silver/statsbomb/.gitkeep
!data/gold/features/.gitkeep
!data/gold/scouting/.gitkeep

# Database files
*.db
*.sqlite
*.sqlite3
database/*.db

# ============================================
# MODELS (NÃO VERSIONAR MODELOS TREINADOS)
# ============================================
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# Mantém estrutura
!models/.gitkeep

# ============================================
# LOGS
# ============================================
logs/
*.log

# ============================================
# REPORTS & OUTPUTS
# ============================================
reports/pdf/*.pdf
reports/visualizations/*.png
reports/visualizations/*.jpg
reports/visualizations/*.svg

# Exceção: manter exemplos
!reports/pdf/example_report.pdf
!reports/visualizations/example_*.png

# ============================================
# IDE / EDITORS
# ============================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# Sublime Text
*.sublime-workspace
*.sublime-project

# ============================================
# OPERATING SYSTEM
# ============================================
# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# ENVIRONMENT VARIABLES
# ============================================
.env
.env.local
.env.*.local
.envrc

# ============================================
# CACHE
# ============================================
.cache/
*.cache
.requests-cache/

# ============================================
# TEMPORARY FILES
# ============================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ============================================
# DOCUMENTATION BUILD
# ============================================
docs/_build/
site/

# ============================================
# POWER BI (OPCIONAL - VERSIONAR SE QUISER)
# ============================================
# Descomentar se não quiser versionar o .pbix
# dashboards/*.pbix

# Mas versionar screenshots
!dashboards/screenshots/*.png

# ============================================
# CREDENTIALS & SECRETS (CRÍTICO!)
# ============================================
credentials.json
secrets.json
*.key
*.pem
config/secrets.yaml

# ============================================
# MISC
# ============================================
nul
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/